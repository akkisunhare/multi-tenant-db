# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB URIs
# Base URI or explicit central & public database URIs
MONGODB_URI=mongodb://127.0.0.1:27017
CENTRAL_DB_NAME=central_db
PUBLIC_DB_NAME=public_db

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true

# JWT Secrets (Independent Secrets per Account Type)
JWT_SUPERADMIN_SECRET=superadmin_jwt_secret_key_prod_quality_2026_x1
JWT_MASTER_SECRET=master_jwt_secret_key_prod_quality_2026_x2
JWT_PUBLIC_SECRET=public_jwt_secret_key_prod_quality_2026_x3
JWT_MASTER_USER_SECRET=master_user_jwt_secret_key_prod_quality_2026_x4

# JWT Expiration & Claims
JWT_EXPIRES_IN=24h
JWT_ISSUER=multi-tenant-auth-service
JWT_AUDIENCE=multi-tenant-app

# Superadmin Seed Credentials
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=Admin@123

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
