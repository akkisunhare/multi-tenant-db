{
  "info": {
    "_postman_id": "b3e05178-5a41-4796-9dc7-8fb4fa741368",
    "name": "Multi-Tenant User Management API (Database-Per-Tenant)",
    "description": "Production-grade Postman collection covering all Superadmin, Master, Public User, Master User, Common Tenant CRUD, and Redis Menu Caching endpoints with automated token persistence.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "superadminToken", "value": "", "type": "string" },
    { "key": "masterToken", "value": "", "type": "string" },
    { "key": "publicToken", "value": "", "type": "string" },
    { "key": "masterUserToken", "value": "", "type": "string" },
    { "key": "masterEmail", "value": "mastera@example.com", "type": "string" },
    { "key": "masterPassword", "value": "Master@123", "type": "string" },
    { "key": "userEmail", "value": "rahul@example.com", "type": "string" },
    { "key": "userPassword", "value": "User@123", "type": "string" },
    { "key": "tenantDataId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "1. Superadmin APIs",
      "item": [
        {
          "name": "POST Superadmin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.token) {",
                  "    pm.collectionVariables.set('superadminToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/superadmin/login", "host": ["{{baseUrl}}"], "path": ["superadmin", "login"] }
          }
        },
        {
          "name": "POST Create Master & Provision Tenant DB",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{superadminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Master A\",\n  \"email\": \"mastera@example.com\",\n  \"password\": \"Master@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/superadmin/master", "host": ["{{baseUrl}}"], "path": ["superadmin", "master"] }
          }
        },
        {
          "name": "GET List Masters",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{superadminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/superadmin/masters?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["superadmin", "masters"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Master APIs",
      "item": [
        {
          "name": "POST Master Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.token) {",
                  "    pm.collectionVariables.set('masterToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mastera@example.com\",\n  \"password\": \"Master@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/master/login", "host": ["{{baseUrl}}"], "path": ["master", "login"] }
          }
        },
        {
          "name": "POST Master Creates User in Tenant DB",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{masterToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul\",\n  \"email\": \"rahul@example.com\",\n  \"password\": \"User@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/master/user", "host": ["{{baseUrl}}"], "path": ["master", "user"] }
          }
        },
        {
          "name": "GET Master Lists Tenant Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{masterToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/master/users?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["master", "users"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "GET Master Menu (Redis Cache)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{masterToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/master/menu", "host": ["{{baseUrl}}"], "path": ["master", "menu"] }
          }
        },
        {
          "name": "POST Invalidate Master Menu Cache",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{masterToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/master/menu/invalidate", "host": ["{{baseUrl}}"], "path": ["master", "menu", "invalidate"] }
          }
        }
      ]
    },
    {
      "name": "3. Public User APIs",
      "item": [
        {
          "name": "POST Public User Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Public User\",\n  \"email\": \"public@example.com\",\n  \"password\": \"Public@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/signup", "host": ["{{baseUrl}}"], "path": ["auth", "signup"] }
          }
        },
        {
          "name": "POST Public User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.token) {",
                  "    pm.collectionVariables.set('publicToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"public@example.com\",\n  \"password\": \"Public@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "GET Public User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{publicToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"] }
          }
        }
      ]
    },
    {
      "name": "4. Master User APIs",
      "item": [
        {
          "name": "POST Master User Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data.token) {",
                  "    pm.collectionVariables.set('masterUserToken', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"masterEmail\": \"mastera@example.com\",\n  \"email\": \"rahul@example.com\",\n  \"password\": \"User@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/master/user/login", "host": ["{{baseUrl}}"], "path": ["master", "user", "login"] }
          }
        },
        {
          "name": "GET Master User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{masterUserToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/master/user/profile", "host": ["{{baseUrl}}"], "path": ["master", "user", "profile"] }
          }
        }
      ]
    },
    {
      "name": "5. Common Tenant CRUD APIs",
      "item": [
        {
          "name": "POST Create Tenant Data Record",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data._id) {",
                  "    pm.collectionVariables.set('tenantDataId', res.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{masterToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Q4 Marketing Strategy\",\n  \"description\": \"Tenant A confidential document\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/data", "host": ["{{baseUrl}}"], "path": ["data"] }
          }
        },
        {
          "name": "GET List Tenant Data Records",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{masterToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/data?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["data"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
          }
        },
        {
          "name": "GET Tenant Data Record by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{masterToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/data/{{tenantDataId}}", "host": ["{{baseUrl}}"], "path": ["data", "{{tenantDataId}}"] }
          }
        },
        {
          "name": "PUT Update Tenant Data Record",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{masterToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Q4 Marketing Strategy (Revised)\",\n  \"description\": \"Updated deliverables for tenant A\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/data/{{tenantDataId}}", "host": ["{{baseUrl}}"], "path": ["data", "{{tenantDataId}}"] }
          }
        },
        {
          "name": "DELETE Tenant Data Record",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{masterToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/data/{{tenantDataId}}", "host": ["{{baseUrl}}"], "path": ["data", "{{tenantDataId}}"] }
          }
        }
      ]
    }
  ]
}
